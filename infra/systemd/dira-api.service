[Unit]
Description=Dir'a Security Platform - Main API (HTTP)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=dira
Group=dira
WorkingDirectory=/opt/dira/backend
EnvironmentFile=/opt/dira/backend/.env
Environment=ENABLE_EMBEDDED_SCHEDULER=false
Environment=ENABLE_EMBEDDED_HONEYPOTS=false
ExecStart=/opt/dira/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dira /var/log/dira /tmp/dira-scans
PrivateTmp=false
# Red Team tools (nmap SYN scans, masscan) need raw sockets without running as root.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
